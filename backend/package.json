{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run dev:api & npm run worker:dev & npm run webhook:worker:dev & wait",
    "dev:api": "tsx watch src/server.ts",
    "build": "tsc && node scripts/fix-prisma-esm-imports.cjs",
    "start": "node --experimental-specifier-resolution=node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "worker:dev": "tsx watch src/workers/message.worker.ts",
    "worker:start": "node --experimental-specifier-resolution=node dist/workers/message.worker.js",
    "webhook:worker:dev": "tsx watch src/workers/webhook.worker.ts",
    "webhook:worker:start": "node --experimental-specifier-resolution=node dist/workers/webhook.worker.js",
    "templates:sync": "tsx src/scripts/sync-templates.ts",
    "webhooks:cleanup": "tsx src/scripts/cleanup-webhooks.ts",
    "cleanup:webhooks": "tsx src/scripts/cleanup.ts --target=webhooks",
    "cleanup:workers": "tsx src/scripts/cleanup.ts --target=workers",
    "cleanup:attempts": "tsx src/scripts/cleanup.ts --target=attempts",
    "cleanup:all": "tsx src/scripts/cleanup.ts --target=all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}

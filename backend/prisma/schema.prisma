generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BLOCKED
}

enum BroadcastStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum MessageStatus {
  QUEUED
  PROCESSING
  SUBMITTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
}

enum BroadcastCategory {
  EMERGENCY
  SERVICE_UPDATE
  REMINDER
  ANNOUNCEMENT
  OTHER
}

enum BroadcastSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BroadcastAudienceType {
  ALL_ACTIVE_SUBSCRIBERS
  GROUP
}

enum WorkerStatus {
  STARTING
  RUNNING
  STOPPING
  STOPPED
  ERROR
}

enum MessageTemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
  UNKNOWN
}

enum MessageStatusEventSource {
  WORKER
  WEBHOOK
  SYSTEM
  ADMIN
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum IncomingMessageStatus {
  UNREAD
  OPEN
  RESOLVED
  IGNORED
}

enum MessageAttemptResult {
  STARTED
  SUCCESS
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

model Admin {
  id                 Int                     @id @default(autoincrement())
  name               String
  email              String                  @unique
  passwordHash       String                  @map("password_hash")
  role               AdminRole               @default(VIEWER)
  isActive           Boolean                 @default(true) @map("is_active")
  createdBroadcasts  Broadcast[]             @relation("CreatedBroadcasts")
  approvedBroadcasts Broadcast[]             @relation("ApprovedBroadcasts")
  rejectedBroadcasts Broadcast[]             @relation("RejectedBroadcasts")
  createdGroups      SubscriberGroup[]       @relation("CreatedGroups")
  addedGroupMembers  SubscriberGroupMember[] @relation("AddedGroupMembers")
  auditLogs          AuditLog[]
  assignedInboxMessages IncomingMessage[]   @relation("AssignedInboxMessages")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@map("admins")
}

model Subscriber {
  id               Int                     @id @default(autoincrement())
  name             String?
  countryCode      String?                 @map("country_code")
  phoneNumber      String                  @unique @map("phone_number")
  optedIn          Boolean                 @default(true) @map("opted_in")
  status           SubscriberStatus        @default(ACTIVE)
  optedInAt        DateTime?               @map("opted_in_at")
  unsubscribedAt   DateTime?               @map("unsubscribed_at")
  lastInboundMessageAt  DateTime?          @map("last_inbound_message_at")
  lastOutboundMessageAt DateTime?          @map("last_outbound_message_at")
  unsubscribeSource     String?            @map("unsubscribe_source")
  consentUpdatedAt      DateTime?          @map("consent_updated_at")
  messages         Message[]
  incomingMessages IncomingMessage[]
  groupMemberships SubscriberGroupMember[]
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([status, optedIn])
  @@map("subscribers")
}

model SubscriberGroup {
  id          Int                     @id @default(autoincrement())
  name        String                  @unique
  description String?                 @db.Text
  createdById Int                     @map("created_by_id")
  createdBy   Admin                   @relation("CreatedGroups", fields: [createdById], references: [id])
  members     SubscriberGroupMember[]
  broadcasts  Broadcast[]
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  @@map("subscriber_groups")
}

model SubscriberGroupMember {
  id           Int             @id @default(autoincrement())
  groupId      Int             @map("group_id")
  subscriberId Int             @map("subscriber_id")
  addedById    Int?            @map("added_by_id")
  group        SubscriberGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subscriber   Subscriber      @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  addedBy      Admin?          @relation("AddedGroupMembers", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@unique([groupId, subscriberId])
  @@index([groupId])
  @@index([subscriberId])
  @@map("subscriber_group_members")
}

model Broadcast {
  id                 Int                   @id @default(autoincrement())
  title              String
  message            String                @db.Text
  templateName       String?               @map("template_name")
  templateLanguage   String?               @map("template_language")
  templateVariables  Json?                 @map("template_variables")
  templateSnapshot   Json?                 @map("template_snapshot")
  messageTemplateId  Int?                  @map("message_template_id")
  messageTemplate    MessageTemplate?      @relation(fields: [messageTemplateId], references: [id], onDelete: SetNull)
  category           BroadcastCategory     @default(ANNOUNCEMENT)
  severity           BroadcastSeverity     @default(LOW)
  audienceType       BroadcastAudienceType @default(ALL_ACTIVE_SUBSCRIBERS) @map("audience_type")
  groupId            Int?                  @map("group_id")
  group              SubscriberGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status             BroadcastStatus       @default(DRAFT)
  totalRecipients    Int                   @default(0) @map("total_recipients")
  createdById        Int                   @map("created_by_id")
  createdBy          Admin                 @relation("CreatedBroadcasts", fields: [createdById], references: [id])
  approvedById       Int?                  @map("approved_by_id")
  approvedBy         Admin?                @relation("ApprovedBroadcasts", fields: [approvedById], references: [id])
  rejectedById       Int?                  @map("rejected_by_id")
  rejectedBy         Admin?                @relation("RejectedBroadcasts", fields: [rejectedById], references: [id])
  messages           Message[]
  submittedAt        DateTime?             @map("submitted_at")
  approvedAt         DateTime?             @map("approved_at")
  rejectedAt         DateTime?             @map("rejected_at")
  queuedAt           DateTime?             @map("queued_at")
  cancelledAt        DateTime?             @map("cancelled_at")
  startedAt          DateTime?             @map("started_at")
  processingStartedAt DateTime?            @map("processing_started_at")
  completedAt        DateTime?             @map("completed_at")
  failedAt           DateTime?             @map("failed_at")
  rejectionReason    String?               @db.Text @map("rejection_reason")
  cancellationReason String?               @db.Text @map("cancellation_reason")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdById])
  @@index([groupId])
  @@index([messageTemplateId])
  @@index([createdAt])
  @@map("broadcasts")
}

model Message {
  id                  Int                  @id @default(autoincrement())
  broadcastId         Int                  @map("broadcast_id")
  subscriberId        Int                  @map("subscriber_id")
  phoneNumber         String               @map("phone_number")
  whatsappMessageId   String?              @unique @map("whatsapp_message_id")
  status              MessageStatus        @default(QUEUED)
  errorCode           String?              @map("error_code")
  errorMessage        String?              @db.Text @map("error_message")
  retryCount          Int                  @default(0) @map("retry_count")
  maxRetries          Int                  @default(3) @map("max_retries")
  nextRetryAt         DateTime?            @map("next_retry_at")
  lastAttemptAt       DateTime?            @map("last_attempt_at")
  processingStartedAt DateTime?            @map("processing_started_at")
  submittedAt         DateTime?            @map("submitted_at")
  failedAt            DateTime?            @map("failed_at")
  cancelledAt         DateTime?            @map("cancelled_at")
  providerMessageId   String?              @unique @map("provider_message_id")
  providerName        String?              @map("provider_name")
  sentAt              DateTime?            @map("sent_at")
  deliveredAt         DateTime?            @map("delivered_at")
  readAt              DateTime?            @map("read_at")
  providerErrorCode   String?              @map("provider_error_code")
  providerErrorSubcode String?             @map("provider_error_subcode")
  providerErrorType   String?              @map("provider_error_type")
  providerErrorTitle  String?              @map("provider_error_title")
  providerErrorDetails String?             @db.Text @map("provider_error_details")
  failureCategory      String?             @map("failure_category")
  requiresManualReview Boolean             @default(false) @map("requires_manual_review")
  deadLetteredAt       DateTime?           @map("dead_lettered_at")
  deadLetterResolvedAt DateTime?           @map("dead_letter_resolved_at")
  lastWebhookAt       DateTime?            @map("last_webhook_at")
  latestProviderTimestamp DateTime?        @map("latest_provider_timestamp")
  workerId            String?              @map("worker_id")
  claimToken          String?              @map("claim_token")
  claimExpiresAt      DateTime?            @map("claim_expires_at")
  broadcast           Broadcast            @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  subscriber          Subscriber           @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  statusEvents        MessageStatusEvent[]
  attempts            MessageAttempt[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@unique([broadcastId, subscriberId])
  @@index([status])
  @@index([broadcastId, status])
  @@index([nextRetryAt])
  @@index([claimExpiresAt])
  @@index([createdAt])
  @@map("messages")
}

model MessageStatusEvent {
  id             Int           @id @default(autoincrement())
  messageId      Int           @map("message_id")
  status         MessageStatus
  newStatus      MessageStatus? @map("new_status")
  previousStatus MessageStatus? @map("previous_status")
  source         MessageStatusEventSource @default(WORKER)
  eventKey       String?       @unique @map("event_key")
  providerTimestamp DateTime?  @map("provider_timestamp")
  workerId       String?       @map("worker_id")
  errorCode      String?       @map("error_code")
  metadata       Json?
  eventTimestamp DateTime      @default(now()) @map("event_timestamp")
  webhookPayload Json?         @map("webhook_payload")
  message        Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([messageId, eventTimestamp])
  @@map("message_status_events")
}

model MessageAttempt {
  id                 Int                  @id @default(autoincrement())
  messageId          Int                  @map("message_id")
  attemptNumber      Int                  @map("attempt_number")
  provider           String
  requestStartedAt   DateTime             @default(now()) @map("request_started_at")
  requestCompletedAt DateTime?            @map("request_completed_at")
  result             MessageAttemptResult @default(STARTED)
  providerMessageId  String?              @map("provider_message_id")
  errorCode          String?              @map("error_code")
  retryable          Boolean?
  message            Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt          DateTime             @default(now()) @map("created_at")

  @@index([messageId])
  @@index([providerMessageId])
  @@map("message_attempts")
}

model MessageTemplate {
  id              Int                   @id @default(autoincrement())
  metaTemplateId  String?               @map("meta_template_id")
  name            String
  language        String
  category        String?
  status          MessageTemplateStatus @default(UNKNOWN)
  headerType      String?               @map("header_type")
  body            String                @db.Text
  footer          String?               @db.Text
  components      Json
  parameterSchema Json?                 @map("parameter_schema")
  lastSyncedAt    DateTime?             @map("last_synced_at")
  broadcasts      Broadcast[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@unique([name, language])
  @@index([status])
  @@index([lastSyncedAt])
  @@map("message_templates")
}

model IncomingMessage {
  id                       Int                   @id @default(autoincrement())
  providerMessageId        String                @unique @map("provider_message_id")
  phoneNumber              String                @map("phone_number")
  subscriberId             Int?                  @map("subscriber_id")
  waContactId              String?               @map("wa_contact_id")
  contactName              String?               @map("contact_name")
  messageType              String                @map("message_type")
  textBody                 String?               @db.Text @map("text_body")
  interactivePayload       Json?                 @map("interactive_payload")
  mediaId                  String?               @map("media_id")
  replyToProviderMessageId String?               @map("reply_to_provider_message_id")
  receivedAt               DateTime              @map("received_at")
  providerTimestamp        DateTime              @map("provider_timestamp")
  status                   IncomingMessageStatus @default(UNREAD)
  assignedAdminId          Int?                  @map("assigned_admin_id")
  rawWebhookEventId        Int?                  @map("raw_webhook_event_id")
  subscriber               Subscriber?           @relation(fields: [subscriberId], references: [id], onDelete: SetNull)
  assignedAdmin            Admin?                @relation("AssignedInboxMessages", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  rawWebhookEvent          WebhookEvent?         @relation(fields: [rawWebhookEventId], references: [id], onDelete: SetNull)
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  @@index([subscriberId])
  @@index([status])
  @@index([assignedAdminId])
  @@index([receivedAt])
  @@map("incoming_messages")
}

model WebhookEvent {
  id                 Int                     @id @default(autoincrement())
  eventKey           String                  @unique @map("event_key")
  objectType         String                  @map("object_type")
  provider           String
  payloadHash        String                  @map("payload_hash")
  payload            Json?
  signatureValid     Boolean                 @map("signature_valid")
  processingStatus   WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processingAttempts Int                     @default(0) @map("processing_attempts")
  errorMessage       String?                 @db.Text @map("error_message")
  receivedAt         DateTime                @default(now()) @map("received_at")
  processedAt        DateTime?               @map("processed_at")
  incomingMessages   IncomingMessage[]
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([processingStatus, receivedAt])
  @@index([receivedAt])
  @@map("webhook_events")
}

model IdempotencyKey {
  id             Int               @id @default(autoincrement())
  key            String
  adminId        Int?              @map("admin_id")
  route          String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([key, route])
  @@index([adminId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int?     @map("admin_id")
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   Int      @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model WorkerHeartbeat {
  id               Int          @id @default(autoincrement())
  workerId         String       @unique @map("worker_id")
  providerName     String       @map("provider_name")
  status           WorkerStatus @default(STARTING)
  startedAt        DateTime     @default(now()) @map("started_at")
  lastHeartbeatAt  DateTime     @default(now()) @map("last_heartbeat_at")
  currentBatchSize Int          @default(0) @map("current_batch_size")
  processedCount   Int          @default(0) @map("processed_count")
  successCount     Int          @default(0) @map("success_count")
  failedCount      Int          @default(0) @map("failed_count")
  hostname         String?
  processId        Int?         @map("process_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("worker_heartbeats")
}

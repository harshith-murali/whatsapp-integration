PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mysql://root:root@localhost:3306/whatsapp_alerts
JWT_SECRET=your_jwt_signing_secret_here

# Background Worker & Mock Provider Settings (Phase 3)
MESSAGE_PROVIDER=mock
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=5
WORKER_CLAIM_TTL_MS=60000
WORKER_MAX_RETRIES=3
WORKER_SHUTDOWN_TIMEOUT_MS=5000

MOCK_PROVIDER_MIN_DELAY_MS=100
MOCK_PROVIDER_MAX_DELAY_MS=500
MOCK_PROVIDER_RETRYABLE_FAILURE_RATE=0.10
MOCK_PROVIDER_PERMANENT_FAILURE_RATE=0.05

RETRY_DELAY_ATTEMPT_1_MS=30000
RETRY_DELAY_ATTEMPT_2_MS=120000
RETRY_DELAY_ATTEMPT_3_MS=600000

# Meta WhatsApp Cloud API (Phase 4/5)
META_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_PATH=/api/webhooks/whatsapp
META_REQUEST_TIMEOUT_MS=15000

WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en
WHATSAPP_DEFAULT_TEMPLATE_NAME=
WHATSAPP_CUSTOMER_SERVICE_WINDOW_HOURS=24

WEBHOOK_PROCESSING_BATCH_SIZE=25
WEBHOOK_RETENTION_DAYS=30
WEBHOOK_WORKER_POLL_INTERVAL_MS=2000

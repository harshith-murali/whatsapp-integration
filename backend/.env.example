# ── Core ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────────────────────
# Local development
DATABASE_URL=mysql://root:root@localhost:3306/whatsapp_alerts
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# ── AWS RDS Production (replace the DATABASE_URL above) ──────────────────────
# DATABASE_URL=mysql://appuser:StrongPassword@your-cluster.rds.amazonaws.com:3306/whatsapp_alerts
# DATABASE_SSL=true
# DATABASE_CONNECTION_LIMIT=20
# DATABASE_CONNECT_TIMEOUT_MS=15000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Development: min 32 chars. Production: min 64 chars.
# Generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_signing_secret_here_must_be_at_least_32_chars
SESSION_DURATION_HOURS=8
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_MAX=5
WEBHOOK_RATE_LIMIT_MAX=1000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIRECTORY=logs
LOG_RETENTION_DAYS=30

# ── Maintenance ──────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_HOURS=24
CLEANUP_BATCH_SIZE=500
WORKER_HEARTBEAT_RETENTION_DAYS=14
MESSAGE_ATTEMPT_RETENTION_DAYS=30

# ── Background Worker & Message Queue (Phase 3) ───────────────────────────────
# Set MESSAGE_PROVIDER=meta once WhatsApp Cloud API credentials are ready.
MESSAGE_PROVIDER=mock
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=5
WORKER_CLAIM_TTL_MS=60000
WORKER_MAX_RETRIES=3
WORKER_SHUTDOWN_TIMEOUT_MS=5000

# ── Mock Provider (development / staging only) ────────────────────────────────
MOCK_PROVIDER_MIN_DELAY_MS=100
MOCK_PROVIDER_MAX_DELAY_MS=500
MOCK_PROVIDER_RETRYABLE_FAILURE_RATE=0.10
MOCK_PROVIDER_PERMANENT_FAILURE_RATE=0.05

# ── Retry Backoff Schedule ────────────────────────────────────────────────────
RETRY_DELAY_ATTEMPT_1_MS=30000
RETRY_DELAY_ATTEMPT_2_MS=120000
RETRY_DELAY_ATTEMPT_3_MS=600000

# ── Meta WhatsApp Cloud API (set MESSAGE_PROVIDER=meta to activate) ───────────
# META_GRAPH_API_VERSION=v21.0
# META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# META_WHATSAPP_ACCESS_TOKEN=your_access_token
# META_APP_SECRET=your_app_secret
# META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
# META_WEBHOOK_PATH=/api/webhooks/whatsapp
# META_REQUEST_TIMEOUT_MS=15000

# Production environment template.
#
# Copy to backend/.env.production ON THE SERVER and fill in the real values.
# Never commit the filled-in file — .env* is gitignored.
#
# Generate secrets with:
#   openssl rand -hex 64     (JWT_SECRET)
#   openssl rand -hex 24     (MYSQL_ROOT_PASSWORD, META_WEBHOOK_VERIFY_TOKEN)

NODE_ENV=production
PORT=3000

# ---- Database -------------------------------------------------------------
# `mysql` is the compose service name, resolved on the docker network.
# MYSQL_ROOT_PASSWORD here must match the value in the root .env.production.
DATABASE_URL=mysql://root:CHANGE_ME_DB_PASSWORD@mysql:3306/whatsapp_alerts
# TLS is not used for the in-cluster MySQL container; set to true only when
# pointing DATABASE_URL at a managed database such as RDS.
DATABASE_SSL=false
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=15000

# ---- Auth -----------------------------------------------------------------
# Must be at least 64 characters or the app refuses to start in production.
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_64
SESSION_DURATION_HOURS=8
# COOKIE_SECURE is forced to true in production, so the app MUST be served
# over HTTPS. Logins fail over plain HTTP.
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# ---- Networking -----------------------------------------------------------
# Must be your real HTTPS origin. A wildcard (*) is rejected in production.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN
FRONTEND_URL=https://CHANGE_ME_YOUR_DOMAIN
# Caddy sits in front of the API, so trust its X-Forwarded-* headers.
TRUST_PROXY=true

# ---- WhatsApp / Meta ------------------------------------------------------
MESSAGE_PROVIDER=meta
META_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v21.0

# Currently the sandbox pair. Swap both when Alert Platform has a verified
# phone number; no code changes are needed.
META_WHATSAPP_PHONE_NUMBER_ID=1208501335684912
META_WHATSAPP_BUSINESS_ACCOUNT_ID=835793169501515

# System User token with expiry "Never".
META_WHATSAPP_ACCESS_TOKEN=CHANGE_ME_SYSTEM_USER_TOKEN
META_APP_SECRET=CHANGE_ME_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_RUN_openssl_rand_hex_24
META_WEBHOOK_PATH=/api/webhooks/whatsapp
META_REQUEST_TIMEOUT_MS=15000

WHATSAPP_DEFAULT_TEMPLATE_NAME=broadcast_alert
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=en
WHATSAPP_CUSTOMER_SERVICE_WINDOW_HOURS=24

# ---- Workers --------------------------------------------------------------
# Each process opens its own pool, so api + 2 workers = 3 x
# DATABASE_CONNECTION_LIMIT against MySQL's max-connections (60).
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3

# ---- Logging --------------------------------------------------------------
# Logs go to stdout for `docker compose logs`; file logging is disabled so the
# container filesystem stays read-only-friendly.
LOG_LEVEL=info
LOG_TO_FILE=false
